# Daouchi .gitignore — keep the repo to source, config and small test fixtures.
# Anything on-demand or ephemeral (models, caches, exports, build output) lives outside the repo.

# Build output
target/
.cargo-target/
**/*.rs.bk

# Daouchi runtime data (normally in ~/.daouchi; ignored in case DAOUCHI_HOME points inside the repo)
.daouchi/
/data/
/models/
/cache/
/exports/

# Model weights and compiled model caches (downloaded on demand)
*.onnx
*.ort
*.pt
*.pth
*.ckpt
*.safetensors
*.mlmodelc/
*.mlpackage/
coreml-cache/

# ONNX Runtime shared library (installed separately or bundled by scripts/bundle-macos.sh)
*.dylib
*.dll
*.so
*.so.*

# SQLite databases and journals
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# Generated by tauri-build
crates/daouchi-desktop/gen/

# Packaging output
*.app/
*.dmg
*.msi
*.AppImage
*.deb
dist/

# Local tooling state (editors, OS, assistants)
.claude/
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db

# Node / Python leftovers (the project has no build step for the web UI)
node_modules/
__pycache__/
*.pyc
.venv/

# Local env and secrets
.env
.env.*
*.pem
*.key

# Scratch
/tmp/
*.log
