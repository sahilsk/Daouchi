{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daouchi",
  "version": "0.1.0",
  "identifier": "com.daouchi.app",
  "build": { "frontendDist": "./frontend" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "public.app-category.music",
    "shortDescription": "Local sound-effects library with semantic search",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
